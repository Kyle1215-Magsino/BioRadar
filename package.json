{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build:css": "tailwindcss -i ./resources/css/app.css -o ./public/css/app.css --minify",
        "build:js": "node build-js.js",
        "build": "npm run build:css && npm run build:js",
        "watch:css": "tailwindcss -i ./resources/css/app.css -o ./public/css/app.css --watch",
        "dev": "npm run watch:css"
    },
    "devDependencies": {
        "tailwindcss": "^3.4.0",
        "esbuild": "^0.19.0"
    },
    "dependencies": {
        "axios": "^1.6.0",
        "jquery": "^3.7.1",
        "datatables.net": "^1.13.7",
        "datatables.net-dt": "^1.13.7",
        "datatables.net-responsive": "^2.5.0",
        "datatables.net-responsive-dt": "^2.5.0",
        "datatables.net-buttons": "^2.4.2",
        "datatables.net-buttons-dt": "^2.4.2",
        "jszip": "^3.10.1",
        "pdfmake": "^0.2.7",
        "sweetalert2": "^11.0.0"
    }
}
